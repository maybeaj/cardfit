# CardFit — 로컬 개발 환경변수 예시 (TEC-01 · C-TEC-003)
#
# 이 파일만 커밋합니다. 실제 값이 담긴 `.env`는 절대 커밋하지 않습니다 (NFR-002 · NFR-005).
# 값은 `npx supabase start`가 출력하는 로컬 접속 정보이며 실사용자 데이터가 아닙니다.
#
# 클라이언트 번들에 노출되면 안 되므로 `NEXT_PUBLIC_` 접두어를 쓰지 않습니다.

# 애플리케이션 런타임 접속 (pgBouncer 경유 — 배포 시 Supabase의 pooler URL)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Migration 전용 직접 접속 (pooler를 우회해야 DDL이 안전하다)
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
